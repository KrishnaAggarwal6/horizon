<div id="efg-social-proof-{{ section.id }}" class="efg-sp">
  <div class="efg-sp__container">
    <!-- Left Content -->
    <div class="efg-sp__content">
      <h2 class="efg-sp__title">{{ section.settings.title }}</h2>

      <ul class="efg-sp__bullets">
        {% for block in section.blocks %}
          {% if block.type == 'bullet' %}
            <li class="efg-sp__bullet" {{ block.shopify_attributes }}>
              <span class="efg-sp__bullet-icon" aria-hidden="true">✓</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      <div class="efg-sp__stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="efg-sp__stat" {{ block.shopify_attributes }}>
              <span class="efg-sp__stat-number">{{ block.settings.number }}</span>
              <span class="efg-sp__stat-label">{{ block.settings.label }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Right Image -->
    <div class="efg-sp__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: 'Fitness lifestyle', class: 'efg-sp__image' }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'efg-sp__placeholder' }}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .efg-sp {
    background: #ffffff;
    padding: 72px 24px;
  }

  .efg-sp__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .efg-sp__content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .efg-sp__title {
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    color: #1a1a6e;
    line-height: 1.2;
  }

  .efg-sp__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .efg-sp__bullet {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: #1e293b;
    font-weight: 500;
  }

  .efg-sp__bullet-icon {
    width: 22px;
    height: 22px;
    background: #1a1a6e;
    color: #ffffff;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .efg-sp__stats {
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    padding-top: 8px;
    border-top: 1px solid #e4e4ea;
  }

  .efg-sp__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .efg-sp__stat-number {
    font-size: 26px;
    font-weight: 700;
    color: #1a1a6e;
    line-height: 1;
  }

  .efg-sp__stat-label {
    font-size: 13px;
    color: #64748b;
    font-weight: 400;
  }

  .efg-sp__media {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .efg-sp__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .efg-sp__placeholder {
    width: 100%;
    height: 100%;
    background: #f4f4f6;
  }

  @media (max-width: 768px) {
    .efg-sp {
      padding: 48px 20px;
    }

    .efg-sp__container {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .efg-sp__media {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "EFG – Social Proof",
  "tag": "section",
  "class": "efg-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Why 5,000+ Athletes Choose EFG"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Image"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Bullet Text",
          "default": "Premium Quality"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Stat Number",
          "default": "75+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat Label",
          "default": "Products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EFG – Social Proof",
      "blocks": [
        {
          "type": "bullet",
          "settings": { "text": "Premium Quality — built to last" }
        },
        {
          "type": "bullet",
          "settings": { "text": "Fast Delivery — ships same day" }
        },
        {
          "type": "bullet",
          "settings": { "text": "Athlete Tested — endorsed by pros" }
        },
        {
          "type": "bullet",
          "settings": { "text": "Built for Results — not just looks" }
        },
        {
          "type": "stat",
          "settings": { "number": "75+", "label": "Products" }
        },
        {
          "type": "stat",
          "settings": { "number": "5.2K", "label": "Reviews" }
        },
        {
          "type": "stat",
          "settings": { "number": "98%", "label": "Satisfaction" }
        }
      ]
    }
  ]
}
{% endschema %}
