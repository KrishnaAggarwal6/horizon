<section id="gc-card-slider-{{ section.id }}" class="gc-card-slider">
  <div class="gc-card-slider__container">
    <div class="gc-card-slider__header">
      <div>
        <p class="gc-card-slider__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="gc-card-slider__title">{{ section.settings.title }}</h2>
      </div>
      <div class="gc-card-slider__arrows">
        <button class="gc-card-slider__arrow gc-card-slider__arrow--prev" aria-label="Scroll left" disabled>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M12.5 15L7.5 10l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="gc-card-slider__arrow gc-card-slider__arrow--next" aria-label="Scroll right">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="gc-card-slider__viewport">
      {% for block in section.blocks %}
        <article class="gc-card-item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#gc-customize' }}" class="gc-card-item__link" aria-label="View {{ block.settings.title }} card">
            <div class="gc-card-item__media">
              {% if block.settings.video_url != blank %}
                <video
                  class="gc-card-item__video"
                  muted loop playsinline
                  preload="none"
                  poster="{{ block.settings.poster | image_url: width: 400 }}"
                  aria-hidden="true"
                >
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              {% elsif block.settings.thumbnail != blank %}
                {{ block.settings.thumbnail | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'gc-card-item__image' }}
              {% else %}
                <div class="gc-card-item__placeholder">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect x="3" y="7" width="34" height="26" rx="3" stroke="currentColor" stroke-width="1.2" fill="none"/>
                    <path d="M3 16h34" stroke="currentColor" stroke-width="1.2" opacity="0.4"/>
                    <circle cx="12" cy="25" r="3" stroke="currentColor" stroke-width="1.2" fill="none"/>
                    <path d="M18 23h12M18 27h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
                  </svg>
                </div>
              {% endif %}
              <div class="gc-card-item__overlay">
                <span class="gc-card-item__play">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="white" aria-hidden="true">
                    <path d="M5 3.5l8 4.5-8 4.5V3.5z"/>
                  </svg>
                </span>
              </div>
            </div>
            <div class="gc-card-item__body">
              {% if block.settings.category != blank %}
                <span class="gc-card-item__tag">{{ block.settings.category }}</span>
              {% endif %}
              <p class="gc-card-item__title">{{ block.settings.title }}</p>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .gc-card-slider {
    background: #f5f5f7;
    padding: 80px 0 72px;
  }

  .gc-card-slider__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .gc-card-slider__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 40px;
    gap: 16px;
  }

  .gc-card-slider__eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #e94560;
  }

  .gc-card-slider__title {
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 700;
    color: #1a1a2e;
    letter-spacing: -0.02em;
  }

  .gc-card-slider__arrows {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .gc-card-slider__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid #e0e0e8;
    background: #ffffff;
    color: #1a1a2e;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .gc-card-slider__arrow:hover:not(:disabled) {
    border-color: #1a1a2e;
    background: #1a1a2e;
    color: #ffffff;
  }

  .gc-card-slider__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .gc-card-slider__viewport {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 8px;
  }

  .gc-card-slider__viewport::-webkit-scrollbar {
    display: none;
  }

  .gc-card-item {
    scroll-snap-align: start;
    flex-shrink: 0;
    width: 220px;
  }

  .gc-card-item__link {
    display: block;
    text-decoration: none;
  }

  .gc-card-item__media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 3/4;
    background: #e8e8f0;
    margin-bottom: 14px;
  }

  .gc-card-item__video,
  .gc-card-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gc-card-item:hover .gc-card-item__video,
  .gc-card-item:hover .gc-card-item__image {
    transform: scale(1.04);
  }

  .gc-card-item__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9999aa;
  }

  .gc-card-item__overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 46, 0);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease;
  }

  .gc-card-item:hover .gc-card-item__overlay {
    background: rgba(26, 26, 46, 0.35);
  }

  .gc-card-item__play {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(233, 69, 96, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .gc-card-item:hover .gc-card-item__play {
    opacity: 1;
    transform: scale(1);
  }

  .gc-card-item__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .gc-card-item__tag {
    display: inline-block;
    background: rgba(233, 69, 96, 0.1);
    color: #e94560;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 50px;
    width: fit-content;
  }

  .gc-card-item__title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #1a1a2e;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .gc-card-slider {
      padding: 56px 0 48px;
    }

    .gc-card-slider__container {
      padding: 0 20px;
    }

    .gc-card-slider__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .gc-card-item {
      width: 180px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GC – Card Slider",
  "tag": "section",
  "class": "gc-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trending Now"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Popular Cards"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "MP4 Video URL",
          "default": "https://www.w3schools.com/html/mov_bbb.mp4"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video Poster Image"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail (fallback)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Happy Birthday"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category Tag",
          "default": "Birthday"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GC – Card Slider",
      "blocks": [
        { "type": "card", "settings": { "title": "Happy Birthday", "category": "Birthday" } },
        { "type": "card", "settings": { "title": "Thank You So Much", "category": "Thank You" } },
        { "type": "card", "settings": { "title": "Congratulations!", "category": "Congratulations" } },
        { "type": "card", "settings": { "title": "Happy Anniversary", "category": "Anniversary" } },
        { "type": "card", "settings": { "title": "Just Because", "category": "Just Because" } },
        { "type": "card", "settings": { "title": "Happy Holidays", "category": "Holiday" } }
      ]
    }
  ]
}
{% endschema %}
