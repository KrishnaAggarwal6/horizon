<link rel="stylesheet" href="{{ 'greeting-cards.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'greeting-cards.js' | asset_url }}" defer></script>

<section id="gc-hero-{{ section.id }}" class="gc-hero">
  <div class="gc-hero__bg"></div>

  <div class="gc-hero__container">
    <div class="gc-hero__content">
      <div class="gc-hero__eyebrow">
        <span class="gc-hero__eyebrow-dot"></span>
        <span>{{ section.settings.eyebrow }}</span>
      </div>

      <h1 class="gc-hero__headline">{{ section.settings.headline }}</h1>

      <p class="gc-hero__subtext">{{ section.settings.subtext }}</p>

      <div class="gc-hero__ctas">
        <a href="{{ section.settings.primary_url | default: '#gc-card-slider' }}" class="gc-hero__btn gc-hero__btn--primary">
          {{ section.settings.primary_label }}
        </a>
        <a href="{{ section.settings.secondary_url | default: '#gc-how-it-works' }}" class="gc-hero__btn gc-hero__btn--secondary">
          <svg class="gc-hero__play-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="7.5" stroke="currentColor" stroke-width="1"/>
            <path d="M6.5 5.5l4 2.5-4 2.5V5.5z" fill="currentColor"/>
          </svg>
          {{ section.settings.secondary_label }}
        </a>
      </div>

      <div class="gc-hero__trust">
        <span class="gc-hero__trust-item">✦ No credit card required</span>
        <span class="gc-hero__trust-item">✦ Free forever plan</span>
        <span class="gc-hero__trust-item">✦ Send in 2 minutes</span>
      </div>
    </div>

    <div class="gc-hero__visual" aria-hidden="true">
      <div class="gc-hero__card-mock gc-hero__card-mock--back"></div>
      <div class="gc-hero__card-mock gc-hero__card-mock--mid"></div>
      <div class="gc-hero__card-mock gc-hero__card-mock--front">
        {% if section.settings.preview_video != blank %}
          <video
            class="gc-hero__preview-video"
            autoplay muted loop playsinline
            poster="{{ section.settings.preview_poster | image_url: width: 480 }}"
          >
            <source src="{{ section.settings.preview_video }}" type="video/mp4">
          </video>
        {% elsif section.settings.preview_image != blank %}
          {{ section.settings.preview_image | image_url: width: 480 | image_tag: loading: 'eager', alt: '', class: 'gc-hero__preview-image' }}
        {% else %}
          <div class="gc-hero__card-placeholder">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="4" y="8" width="40" height="32" rx="4" stroke="#e94560" stroke-width="1.5" fill="none"/>
              <path d="M4 20h40" stroke="#e94560" stroke-width="1.5" opacity="0.3"/>
              <circle cx="14" cy="30" r="4" stroke="#e94560" stroke-width="1.5" fill="none"/>
              <path d="M22 28h14M22 33h10" stroke="#e94560" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
            </svg>
            <p>Animated Card Preview</p>
          </div>
        {% endif %}
        <div class="gc-hero__card-tag">✉ Happy Birthday</div>
      </div>
    </div>
  </div>

  <div class="gc-hero__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 60" fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 60V30C240 0 480 60 720 30C960 0 1200 60 1440 30V60H0Z" fill="#f5f5f7"/>
    </svg>
  </div>
</section>

{% stylesheet %}
  .gc-hero {
    position: relative;
    background: #1a1a2e;
    overflow: hidden;
    padding: 0 0 60px;
  }

  .gc-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 80% 50%, rgba(233, 69, 96, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 20% 30%, rgba(255, 255, 255, 0.03) 0%, transparent 70%);
    pointer-events: none;
  }

  .gc-hero__container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 32px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .gc-hero__content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .gc-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #e94560;
  }

  .gc-hero__eyebrow-dot {
    width: 6px;
    height: 6px;
    background: #e94560;
    border-radius: 50%;
    animation: gc-pulse 2s ease-in-out infinite;
  }

  @keyframes gc-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.4); }
  }

  .gc-hero__headline {
    margin: 0;
    font-size: clamp(36px, 4.5vw, 60px);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .gc-hero__subtext {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.55);
    max-width: 440px;
  }

  .gc-hero__ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .gc-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    border-radius: 50px;
    padding: 15px 32px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
  }

  .gc-hero__btn--primary {
    background: #e94560;
    color: #ffffff;
    box-shadow: 0 8px 32px rgba(233, 69, 96, 0.4);
  }

  .gc-hero__btn--primary:hover {
    background: #d63555;
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(233, 69, 96, 0.5);
  }

  .gc-hero__btn--secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
  }

  .gc-hero__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .gc-hero__play-icon {
    flex-shrink: 0;
  }

  .gc-hero__trust {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .gc-hero__trust-item {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.5px;
  }

  /* Floating card visual */
  .gc-hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 480px;
  }

  .gc-hero__card-mock {
    position: absolute;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.5);
  }

  .gc-hero__card-mock--back {
    width: 260px;
    height: 340px;
    background: linear-gradient(135deg, #2a1a3e, #1a1a4e);
    border: 1px solid rgba(233, 69, 96, 0.15);
    transform: rotate(8deg) translateX(40px) translateY(20px);
    opacity: 0.5;
  }

  .gc-hero__card-mock--mid {
    width: 270px;
    height: 350px;
    background: linear-gradient(135deg, #1a2a4e, #162040);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transform: rotate(-4deg) translateX(-20px) translateY(10px);
    opacity: 0.7;
  }

  .gc-hero__card-mock--front {
    position: relative;
    width: 300px;
    height: 380px;
    background: #111128;
    border: 1px solid rgba(233, 69, 96, 0.2);
    transform: rotate(1deg);
    animation: gc-float 6s ease-in-out infinite;
  }

  @keyframes gc-float {
    0%, 100% { transform: rotate(1deg) translateY(0); }
    50% { transform: rotate(1deg) translateY(-12px); }
  }

  .gc-hero__preview-video,
  .gc-hero__preview-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gc-hero__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    opacity: 0.4;
  }

  .gc-hero__card-placeholder p {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.5px;
  }

  .gc-hero__card-tag {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background: rgba(233, 69, 96, 0.9);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 8px;
    text-align: center;
    letter-spacing: 0.5px;
  }

  .gc-hero__wave {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    line-height: 0;
  }

  .gc-hero__wave svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  @media (max-width: 900px) {
    .gc-hero__container {
      grid-template-columns: 1fr;
      padding: 80px 24px 40px;
      gap: 48px;
    }

    .gc-hero__visual {
      height: 320px;
    }

    .gc-hero__card-mock--front {
      width: 220px;
      height: 280px;
    }

    .gc-hero__card-mock--back {
      width: 190px;
      height: 250px;
    }

    .gc-hero__card-mock--mid {
      width: 200px;
      height: 260px;
    }

    .gc-hero__subtext {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .gc-hero__trust {
      gap: 12px;
    }

    .gc-hero__trust-item:last-child {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GC – Hero",
  "tag": "section",
  "class": "gc-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Premium Animated Cards"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Send Animated Cards That Actually Feel Personal"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Beautiful animated greeting cards you can personalize in seconds and share with anyone — no app download required."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button Label",
      "default": "Browse Cards"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button Label",
      "default": "See How It Works"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "text",
      "id": "preview_video",
      "label": "Preview Video URL (MP4)"
    },
    {
      "type": "image_picker",
      "id": "preview_poster",
      "label": "Video Poster Image"
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "Preview Image (fallback)"
    }
  ],
  "presets": [
    {
      "name": "GC – Hero"
    }
  ]
}
{% endschema %}
