<section id="gc-final-cta-{{ section.id }}" class="gc-final-cta">
  <div class="gc-final-cta__bg" aria-hidden="true">
    <div class="gc-final-cta__orb gc-final-cta__orb--1"></div>
    <div class="gc-final-cta__orb gc-final-cta__orb--2"></div>
  </div>

  <div class="gc-final-cta__container">
    <span class="gc-final-cta__icon" aria-hidden="true">{{ section.settings.icon }}</span>
    <h2 class="gc-final-cta__headline">{{ section.settings.headline }}</h2>
    <p class="gc-final-cta__subtext">{{ section.settings.subtext }}</p>

    <div class="gc-final-cta__actions">
      <a href="{{ section.settings.cta_url | default: '#' }}" class="gc-final-cta__btn gc-final-cta__btn--primary">
        {{ section.settings.cta_label }}
      </a>
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.secondary_url | default: '#' }}" class="gc-final-cta__btn gc-final-cta__btn--ghost">
          {{ section.settings.secondary_label }}
        </a>
      {% endif %}
    </div>

    <p class="gc-final-cta__note">{{ section.settings.note }}</p>
  </div>
</section>

{% stylesheet %}
  .gc-final-cta {
    position: relative;
    background: #1a1a2e;
    padding: 100px 32px;
    overflow: hidden;
    text-align: center;
  }

  .gc-final-cta__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .gc-final-cta__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .gc-final-cta__orb--1 {
    width: 400px;
    height: 400px;
    background: rgba(233, 69, 96, 0.15);
    top: -100px;
    right: -80px;
  }

  .gc-final-cta__orb--2 {
    width: 500px;
    height: 400px;
    background: rgba(74, 138, 255, 0.07);
    bottom: -150px;
    left: -100px;
  }

  .gc-final-cta__container {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .gc-final-cta__icon {
    font-size: 48px;
    display: block;
    animation: gc-float 4s ease-in-out infinite;
    margin-bottom: 8px;
  }

  .gc-final-cta__headline {
    margin: 0;
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .gc-final-cta__subtext {
    margin: 0;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.6;
    max-width: 440px;
  }

  .gc-final-cta__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  .gc-final-cta__btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: 50px;
    padding: 16px 40px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.3px;
    transition: all 0.2s ease;
  }

  .gc-final-cta__btn--primary {
    background: #e94560;
    color: #ffffff;
    box-shadow: 0 10px 40px rgba(233, 69, 96, 0.5);
  }

  .gc-final-cta__btn--primary:hover {
    background: #d63555;
    transform: translateY(-2px);
    box-shadow: 0 16px 56px rgba(233, 69, 96, 0.6);
  }

  .gc-final-cta__btn--ghost {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .gc-final-cta__btn--ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .gc-final-cta__note {
    margin: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.28);
  }

  @media (max-width: 600px) {
    .gc-final-cta {
      padding: 72px 24px;
    }

    .gc-final-cta__btn {
      padding: 14px 32px;
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GC – Final CTA",
  "tag": "section",
  "class": "gc-section",
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon (emoji)",
      "default": "✉️"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Ready to Send Your First Card?"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "It takes less than 2 minutes. No credit card required."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA Label",
      "default": "Get Started Free"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA Label (optional)",
      "default": "Browse Cards"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fine Print",
      "default": "No credit card required · Free plan available forever · Cancel anytime"
    }
  ],
  "presets": [
    {
      "name": "GC – Final CTA"
    }
  ]
}
{% endschema %}
